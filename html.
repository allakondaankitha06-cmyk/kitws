<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Simple Home Page</title>
    <style>
        /* Base styles */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7fb;
            color: #333;
            line-height: 1.6;
        }

        /* Header and Navigation */
        header {
            background-color: #04AA6D;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        /* Main Content Layout */
        main {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        section {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        h1, h2 {
            color: #04AA6D;
        }

        header h1 {
            color: white;
            margin-bottom: 10px;
        }

        /* Call to Action Button */
        .cta-button {
            display: inline-block;
            background-color: #04AA6D;
            color: white;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
            margin-top: 15px;
        }

        .cta-button:hover {
            background-color: #038c5a;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 20px 0;
            background-color: #333;
            color: white;
            position: fixed;
            bottom: 0;
            width: 100%;
            font-size: 0.9rem;
        }

        /* Adjust footer for small screens so it doesn't overlap content */
        @media (max-width: 600px) {
            footer {
                position: static;
            }
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <h1>Welcome to My Website</h1>
        <nav>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Services</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <!-- Main Content Section -->
    <main>
        <section>
            <h2>Hello, World!</h2>
            <p>This is a clean, simple home page built completely from scratch using semantic HTML5 elements and custom CSS styling. It is configured to look great on desktop monitors, tablets, and smartphone layouts alike.</p>
            <p>You can easily modify this template to build out your own portfolio, business landing page, or personal blog project.</p>
            <a href="#" class="cta-button">Get Started</a>
        </section>
    </main>

    <!-- Footer Section -->
    <footer>
        <p>&copy; 2026 My Simple Website. All rights reserved.</p>
    </footer>

</body>
</html>
